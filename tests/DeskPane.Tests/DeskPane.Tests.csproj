<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DeskPaneNativeTestPlatform Condition="'$(Platform)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-arm64'">ARM64</DeskPaneNativeTestPlatform>
    <DeskPaneNativeTestPlatform Condition="'$(DeskPaneNativeTestPlatform)' == ''">x64</DeskPaneNativeTestPlatform>
    <DeskPaneRustCrtLinkage Condition="'$(DeskPaneRustCrtLinkage)' == ''">Static</DeskPaneRustCrtLinkage>
    <DeskPaneNativeTestIntermediateDir>$(MSBuildProjectDirectory)\obj\rust-native\$(Configuration)\$(Platform)\$(RuntimeIdentifier)\$(DeskPaneRustCrtLinkage)</DeskPaneNativeTestIntermediateDir>
    <DeskPaneNativeTestCargoTargetDir>$(DeskPaneNativeTestIntermediateDir)\cargo-target</DeskPaneNativeTestCargoTargetDir>
    <DeskPaneNativeTestDll>$(DeskPaneNativeTestIntermediateDir)\deskpane_native.dll</DeskPaneNativeTestDll>
    <DeskPaneNativeTestPdb>$(DeskPaneNativeTestIntermediateDir)\deskpane_native.pdb</DeskPaneNativeTestPdb>
  </PropertyGroup>

  <ItemGroup>
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\rust-toolchain.toml" />
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\Cargo.toml" />
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\Cargo.lock" />
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\deskpane-native\Cargo.toml" />
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\deskpane-native\src\**\*" />
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\native\include\deskpane_native.h" />
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\scripts\build-rust-native.ps1" />
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\scripts\native-pe-contract.ps1" />
    <DeskPaneNativeTestInput Include="$(MSBuildProjectDirectory)\..\..\scripts\rust-arm64-msvc-environment.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeskPane\DeskPane.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="DeskPane.Platform" />
  </ItemGroup>

  <Target
    Name="BuildDeskPaneNativeTestModule"
    BeforeTargets="CoreCompile"
    Inputs="@(DeskPaneNativeTestInput)"
    Outputs="$(DeskPaneNativeTestDll);$(DeskPaneNativeTestPdb)">
    <Error
      Condition="'$(DeskPaneRustCrtLinkage)' != 'Dynamic' and '$(DeskPaneRustCrtLinkage)' != 'Static'"
      Text="DeskPane test Rust CRT linkage must be Dynamic or Static." />
    <Exec
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-rust-native.ps1&quot; -Platform $(DeskPaneNativeTestPlatform) -Configuration $(Configuration) -CrtLinkage $(DeskPaneRustCrtLinkage) -OutputDirectory &quot;$(DeskPaneNativeTestIntermediateDir)&quot; -CargoTargetDirectory &quot;$(DeskPaneNativeTestCargoTargetDir)&quot;" />
  </Target>

  <Target
    Name="CopyDeskPaneNativeTestModule"
    AfterTargets="Build"
    DependsOnTargets="BuildDeskPaneNativeTestModule">
    <Copy
      SourceFiles="$(DeskPaneNativeTestDll);$(DeskPaneNativeTestPdb)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
